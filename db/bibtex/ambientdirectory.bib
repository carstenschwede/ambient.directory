@inproceedings{fothUbiOpticonParticipatorySousveillance2014,
  title = {{{UbiOpticon}}: {{Participatory Sousveillance}} with {{Urban Screens}} and {{Mobile Phone Cameras}}},
  shorttitle = {{{UbiOpticon}}},
  booktitle = {Proceedings of {{The International Symposium}} on {{Pervasive Displays}} - {{PerDis}} '14},
  author = {Foth, Marcus and Heikkinen, Tommi and Ylipulli, Johanna and Luusua, Anna and Satchell, Christine and Ojala, Timo},
  date = {2014},
  pages = {56--61},
  publisher = {ACM Press},
  location = {Copenhagen, Denmark},
  doi = {10.1145/2611009.2611034},
