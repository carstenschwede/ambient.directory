@article{sakashitaRemoteCoDeRoboticEmbodiment2022,
  title = {{{RemoteCoDe}}: {{Robotic Embodiment}} for {{Enhancing Peripheral Awareness}} in {{Remote Collaboration Tasks}}},
  shorttitle = {{{RemoteCoDe}}},
  author = {Sakashita, Mose and Ricci, E. Andy and Arora, Jatin and Guimbretière, François},
  date = {2022-03-30},
  journaltitle = {Proceedings of the ACM on Human-Computer Interaction},
