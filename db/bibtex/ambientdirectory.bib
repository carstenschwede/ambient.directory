  shorttitle = {{{CAMMInA}}},
  author = {Rodríguez, Marcela D. and Roa, José R. and Morán, Alberto L. and Nava-Muñoz, Sandra},
  date = {2013-08},
  journaltitle = {Personal and Ubiquitous Computing},
  shortjournal = {Pers. Ubiquitous Comput.},
  volume = {17},
  number = {6},
  pages = {1127--1134},
