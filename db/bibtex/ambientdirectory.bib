  booktitle = {Pervasive {{Computing}}},
  author = {Müller, Jörg and Exeler, Juliane and Buzeck, Markus and Krüger, Antonio},
  editor = {Tokuda, Hideyuki and Beigl, Michael and Friday, Adrian and Brush, A. J. Bernheim and Tobe, Yoshito},
  date = {2009},
  volume = {5538},
  pages = {17--24},
