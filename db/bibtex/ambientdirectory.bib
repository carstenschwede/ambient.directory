@incollection{weiserComingAgeCalm1997,
  title = {The {{Coming Age}} of {{Calm Technology}}},
  booktitle = {Beyond {{Calculation}}: {{The Next Fifty Years}} of {{Computing}}},
  author = {Weiser, Mark and Brown, John Seely},
  editor = {Denning, Peter J. and Metcalfe, Robert M.},
  date = {1997},
  pages = {75--85},
  publisher = {Springer New York},
  location = {New York, NY},
  doi = {10.1007/978-1-4612-0685-9_6},
  url = {https://doi.org/10.1007/978-1-4612-0685-9_6},
  urldate = {2019-01-29},
  abstract = {The important waves of technological change are those that fundamentally alter the place of technology in our lives. What matters is not technology itself, but its relationship to us.},
  isbn = {978-1-4612-0685-9},
  langid = {english},
  keywords = {Information Highway,Open Office,Open Office Plan,Small Electric Motor,Ubiquitous Computing},
  note = {\textbf{Extracted Annotations (9/1/2020, 1:23:05 PM)}
\par
"The UC will bring information technology beyond the big problems like corporate finance and school homework to the little annoyances like, Where are the car-keys, Can I get a parking place, and Is that shirt I saw last week at Macy's still on the rack?" (\href{zotero://open-pdf/library/items/4CP57RC2?page=4}{Weiser and Brown 1997:78})
\par
"If computers are everywhere, they had better stay out of the way, and that means designing them so that the people being shared by the computers remain serene and in control." (\href{zotero://open-pdf/library/items/4CP57RC2?page=5}{Weiser and Brown 1997:79})
\par
"Computers for personal use have focused on the excitement of interaction. But when computers are all around, so that we want to compute while doing something else and have more time to be more fully human, we must radically rethink the goals, context, and technology of the computer and all the other technology crowding into our lives." (\href{zotero://open-pdf/library/items/4CP57RC2?page=5}{Weiser and Brown 1997:79})
\par
"Information technology is more often the enemy of calm. Pagers, cellphones, news services, the World Wide Web, e-mail.Tv. and radio bombard us frenetically." (\href{zotero://open-pdf/library/items/4CP57RC2?page=5}{Weiser and Brown 1997:79})
\par
"Calm technology engages both the center and the periphery of our attention and in fact moves back and forth between the two." (\href{zotero://open-pdf/library/items/4CP57RC2?page=5}{Weiser and Brown 1997:79})
\par
"A calm technology will move easily from the periphery of our attention, to the center, and back." (\href{zotero://open-pdf/library/items/4CP57RC2?page=6}{Weiser and Brown 1997:80})
\par
"First, by placing things in the periphery we are able to attune to many more things than we could if everything had to be at the center. Things in the periphery are attuned to by the large portion of our brains devoted to peripheral (sensory) processing. Thus the periphery is informing without overburdenmg." (\href{zotero://open-pdf/library/items/4CP57RC2?page=6}{Weiser and Brown 1997:80})
\par
"The dangling string increases our peripheral reach to the formerly inaccessible network traffic. While screen displays of traffic are common, their symbols require interpretation and attention, and do not peripheralize well. The string, in part because it is actually in the physical world, has a better impedance match with our brain's peripheral nerve centers." (\href{zotero://open-pdf/library/items/4CP57RC2?page=10}{Weiser and Brown 1997:84})},
  file = {/Users/carstenschwede/Google Drive/CITEC/Zotero/storage/4CP57RC2/Weiser_Brown_1997_The Coming Age of Calm Technology.pdf},
  date-added = {2019-01-29}
}

