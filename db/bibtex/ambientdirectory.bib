  booktitle = {Ambient {{Intelligence}}},
  author = {Schrammel, Johann and Gerdenitsch, Cornelia and Weiss, Astrid and Kluckner, Patricia M. and Tscheligi, Manfred},
  editor = {Keyson, David V. and Maher, Mary Lou and Streitz, Norbert and Cheok, Adrian and Augusto, Juan Carlos and Wichert, Reiner and Englebienne, Gwenn and Aghajan, Hamid and Kröse, Ben J. A.},
  date = {2011},
  volume = {7040},
