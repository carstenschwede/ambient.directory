@inproceedings{davisPromotingSocialConnectedness2016,
  title = {Promoting {{Social Connectedness}} through {{Human Activity-Based Ambient Displays}}},
  booktitle = {Proceedings of the {{International Symposium}} on {{Interactive Technology}} and {{Ageing Populations}} - {{ITAP}} '16},
  author = {Davis, Kadian and Owusu, Evans and Hu, Jun and Marcenaro, Lucio and Regazzoni, Carlo and Feijs, Loe},
  date = {2016},
  pages = {64--76},
  publisher = {ACM Press},
  location = {Kochi, Japan},
  doi = {10.1145/2996267.2996274},
  url = {http://dl.acm.org/citation.cfm?doid=2996267.2996274},
  urldate = {2019-08-06},
  abstract = {Existing research in ambient assisted living (AAL) confirms the success of context aware applications in conveying feelings of connectedness and creating a sense of co-presence. Awareness of an elder’s activities could trigger emotional responses and reveal pertinent information concerning their health, moods and habits. This paper presents a bidirectional ambient display platform, enabling asynchronous viewing of activity levels to create awareness and enhance social connectedness. An automatic smartphone based human activity recognition (HAR) system reveals activities of the elderly and caregivers in their daily lives. The results suggest that perception of activity levels is useful for fostering social connectedness and strengthening engagement between caregivers and their elderly counterparts. These findings may help interaction designers tailor AAL solutions for increased social interaction and context awareness.},
  eventtitle = {The {{International Symposium}}},
