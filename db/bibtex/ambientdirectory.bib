@inproceedings{spiekerSMALLCARScaledModel2017,
  title = {{{SMALLCAR}}: {{A Scaled Model}} for {{Ambient Light Display Creation}} and {{Review}} of {{In-Vehicle Light Patterns}}},
  shorttitle = {{{SMALLCAR}}},
  booktitle = {Proceedings of the 9th {{International Conference}} on {{Automotive User Interfaces}} and {{Interactive Vehicular Applications Adjunct}}  - {{AutomotiveUI}} '17},
  author = {Spieker, Jannik and Löcken, Andreas and Heuten, Wilko and Boll, Susanne},
  date = {2017},
  pages = {120--125},
