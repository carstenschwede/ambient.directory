@article{tovaresPublicLonelinessEndurance2020,
  title = {The Public Loneliness of Endurance Athletes: {{Creating}} Ambient Affiliation through Involvement Strategies on {{Twitter}}},
  shorttitle = {The Public Loneliness of Endurance Athletes},
  author = {Tovares, Alla V.},
  date = {2020-04},
  journaltitle = {Discourse, Context \& Media},
  shortjournal = {Discourse Context Media},
  volume = {34},
  pages = {100380},
  issn = {22116958},
  doi = {10.1016/j.dcm.2020.100380},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S2211695820300131},
  urldate = {2020-09-06},
  abstract = {The accessibility and interactivity of Twitter both facilitate athlete-fan interaction and contribute to the time/space compression between sporting events and communication about them. While numerous studies investigate real-time participatory engagement of fans on Twitter, athletes’ use of Twitter during competition remains underexplored. Using a case study approach, this study brings together computermediated discourse analysis and prior work on involvement in discourse to examine tweets posted during competitive events by two endurance athletes (an experienced amateur marathon runner and an elite rock climber). Specifically, it explores how athletes mobilize various linguistic strategies to create relations of connectedness, or ambient affiliation (Zappavigna, 2011), with their respective audiences who are distanced spatially and often temporally. It also demonstrates how the affordances and limitations of technology, and the constraints of the athletic events themselves, shape ambient involvement. In this way, this work adds to our understanding of how ambient affiliation is constructed in a particular context – a competitive athletic event of an endurance athlete practicing a solitary sport – while also shedding light on how involvement is created and maintained with a largely unknown online audience.},
  citations = {5},
  citationsdate = {2022-01-19},
  langid = {english},
  file = {/Users/carstenschwede/Google Drive/CITEC/Zotero/storage/Y5HDXMSG/Tovares - 2020 - The public loneliness of endurance athletes Creat.pdf},
  date-added = {2020-09-06}
}

