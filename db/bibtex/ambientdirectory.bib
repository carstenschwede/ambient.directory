@article{bealeAmbientArtInformation,
  title = {Ambient {{Art}}: {{Information Without Attention}}},
  author = {Beale, Russell},
  abstract = {Art explores and expresses our aesthetic relation to our environment and ourselves. However, since the rise of photography, the value ascribed to art’s representative power has waned and in its place are explorations of the poetics of each piece, the way in which an object’s materiality intervenes in the space (and time) in which it is sited, authorship, the role of the viewer and so on. In 2D media, these subjects have been explored in many ways. Mark Rothko, concerned with the search for the sublime, created vast modernist works than aimed to stupefy the viewer into a response to the hidden ‘divine’. Picasso’s light paintings subverted the photograph’s modus operandi by generating an image over time, rather than in a single snapshot instant. Many artists working in video explore directly the way in which time and image can interact.},
