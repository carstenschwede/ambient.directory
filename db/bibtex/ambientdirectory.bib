@inproceedings{palaySuChefInkitchenDisplay2009,
  title = {{{SuChef}}: An in-Kitchen Display to Assist with "Everyday" Cooking},
  shorttitle = {{{SuChef}}},
  booktitle = {Proceedings of the 27th International Conference Extended Abstracts on {{Human}} Factors in Computing Systems - {{CHI EA}} '09},
  author = {Palay, Joshua and Newman, Mark},
  date = {2009},
  pages = {3973},
  publisher = {ACM Press},
  location = {Boston, MA, USA},
  doi = {10.1145/1520340.1520603},
  url = {http://portal.acm.org/citation.cfm?doid=1520340.1520603},
  urldate = {2019-08-06},
  abstract = {Decisions about what to eat are often made close to mealtime, when hunger clouds people’s ability to think creatively or conscientiously about their meal choices. As a result, people we studied tended to resort to “everyday meals”: recipes that are tasty, quick, and cheap. These choices often run counter to cooks’ stated values regarding health, variety, ingredient choice, and so forth, but are chosen for their convenience and familiarity. This lack of variety seemed to stem from a scarcity of “everyday” recipes compounded by the fact that usually, at the time they are preparing the meal, cooks are tired, hungry, and don’t want to search for or try less familiar recipes. Based on a study of current cooking practices, we developed the SuChef prototype: a low-fidelity probe supporting the in-kitchen display of everyday meal ideas along with the sharing of recipes among members of social groups. The probe was deployed for a week among 5 geographically dispersed but socially connected households and yielded insights into the design space for technology to support everyday cooking.},
  eventtitle = {The 27th International Conference Extended Abstracts},
  isbn = {978-1-60558-247-4},
  langid = {english},
  file = {/Users/carstenschwede/Google Drive/CITEC/Zotero/storage/XGHKNP6U/Palay and Newman - 2009 - SuChef an in-kitchen display to assist with ever.pdf},
  date-added = {2019-08-06}
}

@incollection{riggerDesignSciencePractice2015,
  title = {Design {{Science}} in {{Practice}}: {{Design}} and {{Evaluation}} of an {{Art Based Information System}} to {{Improve Indoor Air Quality}} at {{Schools}}},
  shorttitle = {Design {{Science}} in {{Practice}}},
  booktitle = {New {{Horizons}} in {{Design Science}}: {{Broadening}} the {{Research Agenda}}},
  author = {Rigger, Paul and Wortmann, Felix and Dahlinger, André},
  editor = {Donnellan, Brian and Helfert, Markus and Kenneally, Jim and VanderMeer, Debra and Rothenberger, Marcus and Winter, Robert},
